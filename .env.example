# Produkční tajemství a nastavení pro compose.prod.yaml – zkopírovat do `.env` (gitignored) vedle
# compose.prod.yaml a doplnit (docs/nasazeni.md). Offline kopii `.env` uložit mimo server.

# --- PostgreSQL ---
POSTGRES_USER=sraz
# Generovat `openssl rand -hex 32` – NE base64: jde přes ${} interpolaci v compose, kde by Compose
# znak `$` expandoval.
POSTGRES_PASSWORD=

# --- Appka (application-prod.properties) – bez nich appka nenastartuje ---
# `openssl rand -base64 64 | tr -d '\n'` (jde přes env_file doslova, base64 nevadí)
JWT_SECRET=
# Klíč pro šifrování tokenů Fio API v DB: `openssl rand -base64 32`. Změna klíče zneplatní uložené
# tokeny (organizátoři je musí zadat znovu) – proto patří i do offline kopie `.env`.
FIO_TOKEN_KEY=

# --- SMTP (přihlašovací kódy, pozvánky) ---
# SMTP_PORT musí zůstat 587 (STARTTLS) – Hetzner blokuje odchozí 25 a 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# VŽDY v uvozovkách – ops/*.sh načítají .env přes bash `source` a `<` bez uvozovek je syntaktická
# chyba (Docker Compose uvozovky správně odstraní).
SMTP_FROM="Sraz <kontakt@sraz.app>"

# --- Web (sraz-fe/Caddyfile) ---
# Nejdřív proti IP bez TLS (http://<IP serveru>), po přepnutí DNS https://sraz.app
SITE_ADDRESS=https://sraz.app
# WWW_ADDRESS=https://www.sraz.app
# Upozornění Let's Encrypt na problémy s obnovou certifikátu (výchozí kontakt@sraz.app)
# ACME_EMAIL=kontakt@sraz.app
# Při prvním ladění DNS/TLS staging autorita, ať se nepálí ostrý rate limit:
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# --- Aktivní profily ---
SPRING_PROFILES_ACTIVE=prod

# --- Nouzový přístup bez funkčního SMTP ---
# Přihlašovací kód se místo e-mailu vypíše do logu backendu. Vrátit zpět (smazat) dřív,
# než appku uvidí kdokoli další.
# APP_AUTH_OTP_MAIL_ENABLED=false
