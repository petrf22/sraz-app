# Backend secrets — copy to `.env` (gitignored) and fill in real values, or set
# these as environment variables in your IDE run configuration / deployment.
# Spring Boot relaxed binding maps these env vars onto the matching properties.

# JWT signing secret (base64). Generate a new one, e.g.:
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# Resend API key for transactional/magic-link e-mail
APP_MAIL_RESEND_API_KEY=

# SMTP credentials (Gmail app password in production)
MAIL_USER=
MAIL_PASS=

# Database (defaults to local docker-compose Postgres if unset)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5436/sraz
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=1234
