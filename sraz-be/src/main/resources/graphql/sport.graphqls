# Skupiny, členství, místa, akce a přihlášky.
# Všechna pole vyžadují přihlášeného uživatele; oprávnění (člen / organizátor / admin) kontrolují služby.

enum MemberType { REGULAR SUBSTITUTE }
enum Position { PLAYER GOALIE }
enum MembershipStatus { INVITED ACTIVE DECLINED REMOVED }
enum EventStatus { PLANNED OPEN LOCKED DONE CANCELLED }
enum RegistrationStatus { IN OUT WAITLIST }
enum RegistrationSource { EMAIL_LINK WEB ORGANIZER }
enum Recurrence { WEEKLY MONTHLY }
enum ChargeKind { REGULAR SUBSTITUTE GOALIE }
enum PaymentMethod { CASH TRANSFER }
enum BankEntryKind { EVENT MANUAL }
enum DayOfWeek { MONDAY TUESDAY WEDNESDAY THURSDAY FRIDAY SATURDAY SUNDAY }

"Veřejně viditelné údaje o uživateli (bez e-mailu)."
type PublicUser {
    id: ID!
    publicName: String!
}

type SportGroup {
    id: ID!
    name: String!
    description: String
    teams: [Team!]!
    venues: [Venue!]!
    members: [GroupMember!]!
    "Členství přihlášeného uživatele (null u admina, který není členem)."
    myMembership: GroupMember
    amOrganizer: Boolean!
    events(from: DateTime, to: DateTime): [Event!]!
    "Opakované akce skupiny."
    series: [EventSeries!]!
    "Účet pro QR platby (IBAN)."
    iban: String
    "Zůstatek banku skupiny v Kč."
    bankBalance: Float!
    bankEntries: [BankEntry!]!
    "Statistiky aktivních členů za období (bez zadání = aktuální sezóna září–srpen)."
    stats(from: Date, to: Date): [PlayerStats!]!
}

type Team {
    id: ID!
    name: String!
    color: String
    sortOrder: Int!
}

type Venue {
    id: ID!
    name: String!
    address: String
    mapUrl: String
    latitude: Float
    longitude: Float
}

type GroupMember {
    id: ID!
    group: SportGroup!
    "E-mail vidí jen organizátor a člen sám."
    email: String
    user: PublicUser
    memberType: MemberType!
    position: Position!
    organizer: Boolean!
    status: MembershipStatus!
    invitedBy: PublicUser
    respondedAt: DateTime
}

type Event {
    id: ID!
    group: SportGroup!
    venue: Venue
    name: String!
    startsAt: DateTime!
    durationMinutes: Int!
    maxPlayersPerTeam: Int!
    maxGoalies: Int!
    signupDeadline: DateTime!
    inviteRegularsHoursBefore: Int!
    inviteSubstitutesHoursBefore: Int!
    regularsInvitedAt: DateTime
    substitutesInvitedAt: DateTime
    status: EventStatus!
    note: String
    "Série, ze které termín vznikl (null = jednorázová akce)."
    series: EventSeries
    "Organizátor termín ručně upravil – přegenerování období ho nepřepíše."
    detached: Boolean!
    "Připomínka přihlášeným X hodin před začátkem (null = bez připomínky)."
    reminderHoursBefore: Int
    "Cena ledu/hřiště za hodinu v Kč (null = zdarma)."
    pricePerHour: Float
    "Poplatek stálého člena – platí max(poplatek, podíl)."
    regularFee: Float
    "Kdy bylo vyúčtování uzavřeno (null = otevřené)."
    closedAt: DateTime
    "Platby: organizátor vidí všechny, člen jen svou."
    charges: [Charge!]!
    "Lze se ještě sám přihlásit/odhlásit (před uzávěrkou, akce není zrušená)."
    signupOpen: Boolean!
    registrations: [Registration!]!
    myRegistration: Registration
    summary: EventSummary!
}

type Registration {
    id: ID!
    user: PublicUser!
    status: RegistrationStatus!
    position: Position!
    team: Team
    source: RegistrationSource!
    queuedAt: DateTime
    "Potvrzení účasti organizátorem (null = nepotvrzeno)."
    attended: Boolean
    goals: Int!
    assists: Int!
    createdAt: DateTime
    updatedAt: DateTime
}

type EventSeries {
    id: ID!
    name: String!
    periods: [SeriesPeriod!]!
}

"Období série s pravidlem opakování (např. září–březen každý pátek)."
type SeriesPeriod {
    id: ID!
    validFrom: Date!
    validTo: Date!
    recurrence: Recurrence!
    "Každý N-tý týden / měsíc."
    intervalCount: Int!
    daysOfWeek: [DayOfWeek!]!
    "Jen MONTHLY: kolikátý výskyt dne v měsíci (1–5, -1 = poslední)."
    monthWeeks: [Int!]!
    "Čas začátku HH:mm (Europe/Prague)."
    startTime: String!
    durationMinutes: Int!
    venue: Venue
    maxPlayersPerTeam: Int!
    maxGoalies: Int!
    deadlineHoursBefore: Int!
    inviteRegularsHoursBefore: Int!
    inviteSubstitutesHoursBefore: Int!
    reminderHoursBefore: Int
    pricePerHour: Float
    regularFee: Float
    note: String
}

"Co se stalo s termíny po uložení/smazání období."
type SyncResult {
    created: Int!
    updated: Int!
    removed: Int!
    "Termíny s přihláškami/pozvánkami, zrušené nebo ručně upravené – zůstaly beze změny."
    kept: Int!
}

"Platba účastníka za termín; variabilní symbol = id."
type Charge {
    id: ID!
    event: Event!
    user: PublicUser!
    kind: ChargeKind!
    amount: Float!
    paidAt: DateTime
    paidMethod: PaymentMethod
    "IBAN skupiny pro QR platbu (null = platit organizátorovi)."
    iban: String
}

type BankEntry {
    id: ID!
    kind: BankEntryKind!
    "Kladně příjem, záporně výdaj (Kč)."
    amount: Float!
    description: String!
    event: Event
    createdBy: PublicUser
    createdAt: DateTime
}

"Statistiky hráče za období (jen odehrané, nezrušené termíny)."
type PlayerStats {
    user: PublicUser!
    memberType: MemberType!
    position: Position!
    "Odehraných termínů v období."
    events: Int!
    attended: Int!
    "Přihlášen, ale nepřišel."
    noShow: Int!
    declined: Int!
    noAnswer: Int!
    attendanceRate: Float!
    goals: Int!
    assists: Int!
    charged: Float!
    paid: Float!
}

type EventSummary {
    players: Int!
    maxPlayers: Int!
    goalies: Int!
    maxGoalies: Int!
    waitlist: Int!
}

input GroupInput {
    name: String!
    description: String
    "IBAN pro QR platby (prázdné = bez účtu)."
    iban: String
}

input TeamInput {
    id: ID
    name: String!
    color: String
    sortOrder: Int
}

input VenueInput {
    id: ID
    name: String!
    address: String
    mapUrl: String
    latitude: Float
    longitude: Float
}

input MemberInviteInput {
    email: String!
    memberType: MemberType
    position: Position
}

input MemberUpdateInput {
    memberType: MemberType
    position: Position
    organizer: Boolean
}

"Nevyplněné hodnoty = výchozí nastavení (60 min, 10 hráčů na tým, 2 brankáři, pozvánky 96/48 h předem, uzávěrka 24 h předem)."
input EventInput {
    name: String!
    startsAt: DateTime!
    durationMinutes: Int
    venueId: ID
    maxPlayersPerTeam: Int
    maxGoalies: Int
    signupDeadline: DateTime
    inviteRegularsHoursBefore: Int
    inviteSubstitutesHoursBefore: Int
    reminderHoursBefore: Int
    pricePerHour: Float
    regularFee: Float
    note: String
}

"Nevyplněné hodnoty = výchozí nastavení jako u jednorázové akce; uzávěrka je v hodinách před začátkem."
input PeriodInput {
    validFrom: Date!
    validTo: Date!
    recurrence: Recurrence!
    intervalCount: Int
    daysOfWeek: [DayOfWeek!]!
    monthWeeks: [Int!]
    "HH:mm"
    startTime: String!
    durationMinutes: Int
    venueId: ID
    maxPlayersPerTeam: Int
    maxGoalies: Int
    deadlineHoursBefore: Int
    inviteRegularsHoursBefore: Int
    inviteSubstitutesHoursBefore: Int
    reminderHoursBefore: Int
    pricePerHour: Float
    regularFee: Float
    note: String
}

extend type Query {
    myGroups: [SportGroup!]!
    group(id: ID!): SportGroup!
    event(id: ID!): Event!
    "Nadcházející termíny ve všech mých skupinách."
    myUpcomingEvents: [Event!]!
    "Pozvánky do skupin, které čekají na moji odpověď."
    myGroupInvites: [GroupMember!]!
    "Náhled termínů období před uložením."
    periodPreview(input: PeriodInput!): [DateTime!]!
    "Moje platby (nejnovější první)."
    myCharges: [Charge!]!
}

extend type Mutation {
    groupCreate(input: GroupInput!): SportGroup!
    groupUpdate(id: ID!, input: GroupInput!): SportGroup!
    teamSave(groupId: ID!, input: TeamInput!): Team!
    teamDelete(id: ID!): Boolean!
    venueSave(groupId: ID!, input: VenueInput!): Venue!
    venueDelete(id: ID!): Boolean!

    memberInvite(groupId: ID!, input: MemberInviteInput!): GroupMember!
    memberUpdate(id: ID!, input: MemberUpdateInput!): GroupMember!
    "Odebrání člena organizátorem nebo odchod ze skupiny."
    memberRemove(id: ID!): GroupMember!
    groupInviteRespond(memberId: ID!, accept: Boolean!): GroupMember!

    eventCreate(groupId: ID!, input: EventInput!): Event!
    eventUpdate(id: ID!, input: EventInput!): Event!
    eventCancel(id: ID!, reason: String): Event!
    "Rozešle pozvánky hned (vrací počet odeslaných e-mailů)."
    eventSendInvitations(id: ID!, memberType: MemberType!): Int!

    "Přihlášení/odhlášení přihlášeného uživatele."
    registrationRespond(eventId: ID!, status: RegistrationStatus!, teamId: ID): Registration!
    seriesCreate(groupId: ID!, name: String!): EventSeries!
    seriesRename(id: ID!, name: String!): EventSeries!
    "Smaže sérii: budoucí termíny bez aktivity zmizí, ostatní zůstanou jako samostatné akce."
    seriesDelete(id: ID!): SyncResult!
    "Uloží období (id = null → nové) a srovná s ním budoucí termíny."
    periodSave(seriesId: ID!, id: ID, input: PeriodInput!): SyncResult!
    periodDelete(id: ID!): SyncResult!

    "Potvrzení účasti po akci (jen u přihlášeného člena)."
    attendanceSet(eventId: ID!, userId: ID!, attended: Boolean!): Registration!
    "Góly a asistence hráče na termínu."
    scoreSet(eventId: ID!, userId: ID!, goals: Int!, assists: Int!): Registration!
    "Uzavře vyúčtování: vzniknou platby a pohyb v banku."
    eventClose(id: ID!): [Charge!]!
    "Znovu otevře vyúčtování – jen dokud nikdo nezaplatil."
    eventReopen(id: ID!): Event!
    chargeSetPaid(id: ID!, paid: Boolean!, method: PaymentMethod): Charge!
    "Ruční pohyb v banku (kladně příjem, záporně výdaj)."
    bankEntryAdd(groupId: ID!, amount: Float!, description: String!): BankEntry!
    bankEntryDelete(id: ID!): Boolean!

    "Organizátor nastaví přihlášku libovolnému členovi (i po uzávěrce)."
    registrationSet(eventId: ID!, userId: ID!, status: RegistrationStatus!, teamId: ID, position: Position): Registration!
}
